<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:Sinfonia.ViewModels.Application.Document"
			 xmlns:c="using:StudioLaValse.Drawable.Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Sinfonia.Controls.CanvasControl"
			 x:DataType="vm:CanvasViewModel">
	<Grid>
		<c:InteractiveControl Name="canvas"
							  Zoom="{Binding Zoom}"
							  TranslateX="{Binding TranslateX}"
							  TranslateY="{Binding TranslateY}"/>
		<c:SelectionBorder Name="selectionBorder"/>
	</Grid>
</UserControl>
