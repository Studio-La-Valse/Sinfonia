<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:vm="using:Sinfonia.ViewModels.Application.Menu"
			 xmlns:vmb="using:Sinfonia.ViewModels.Base"
             x:Class="Sinfonia.Controls.MenuControl"
			 x:DataType="vm:MenuViewModel">
	
	<Grid ColumnDefinitions="50 240 *" DockPanel.Dock="Top" HorizontalAlignment="Left" >

		<ItemsControl Grid.Column="1" ItemsSource="{Binding Items}">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<StackPanel Orientation="Horizontal"/>
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>
			<ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="vmb:MenuItemViewModel">
					<Button Content="{Binding Icon}" DataContext="{Binding}">
						<Button.Flyout>
							<MenuFlyout ItemsSource="{Binding Items}" Placement="BottomEdgeAlignedLeft">
								<MenuFlyout.ItemTemplate>
									<DataTemplate x:DataType="vmb:MenuItemViewModel">
										<MenuItem DataContext="{Binding}"/>
									</DataTemplate >
								</MenuFlyout.ItemTemplate >
							</MenuFlyout>
						</Button.Flyout>
					</Button>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
	</Grid>
</UserControl>
