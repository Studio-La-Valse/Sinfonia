<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:vma="using:Sinfonia.ViewModels.Application"
			 xmlns:vmb="using:Sinfonia.ViewModels.Base"
			 xmlns:i="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
			 xmlns:controls="using:Sinfonia.Controls"
             x:Class="Sinfonia.Controls.SideBarControl"
			 x:DataType="vma:SideBarViewModel">

	<UserControl.DataTemplates>
		<DataTemplate DataType="vma:DocumentStyleEditorViewModel">
			<controls:StyleTemplateEditorControl/>
		</DataTemplate>
		<DataTemplate DataType="vma:UserAccountViewModel">
			<controls:UserAccountControl/>
		</DataTemplate>
	</UserControl.DataTemplates>
	
	<TabControl Name="tabs" SelectedItem="{Binding ActiveSideBar}" ItemsSource="{Binding SideBars}" TabStripPlacement="Left">
		<TabControl.ItemTemplate>
			<DataTemplate x:DataType="vmb:SideBarContentViewModel">
				<i:MaterialIcon Kind="{Binding Icon}" Margin="10"/>
			</DataTemplate>
		</TabControl.ItemTemplate>

		<TabControl.ContentTemplate>
			<DataTemplate x:DataType="vmb:SideBarContentViewModel">

				<DockPanel HorizontalAlignment="Stretch">

					<DockPanel DockPanel.Dock="Top">
						<Button Content="{i:MaterialIconExt Kind=Menu}" DockPanel.Dock="Left" Width="40">
							<Button.Flyout>
								<MenuFlyout Placement="BottomEdgeAlignedLeft">
								</MenuFlyout>
							</Button.Flyout>
						</Button>
						<Button Content="{i:MaterialIconExt Kind=ArrowLeft}" DockPanel.Dock="Right" Width="40" Command="{Binding #tabs.((vma:SideBarViewModel)DataContext).TriggerPaneCommand}"/>
						<TextBlock Text="{Binding Header}" VerticalAlignment="Center"/>
					</DockPanel>

					<ScrollViewer HorizontalContentAlignment="Stretch">
						<ContentControl Content="{Binding}" HorizontalAlignment="Stretch"/>
					</ScrollViewer>
				</DockPanel>

			</DataTemplate>
		</TabControl.ContentTemplate>
	</TabControl>
	
</UserControl>
