<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:vma="using:Sinfonia.ViewModels.Application"
			 xmlns:m="using:StudioLaValse.ScoreDocument.Models"
             x:Class="Sinfonia.Controls.UserAccountControl"
			 x:DataType="vma:UserAccountViewModel">
	<StackPanel>
		<StackPanel IsVisible="{Binding !UserIsLoggedIn}">
			<Button Command="{Binding LoginCommand}" >Login</Button>
			<Button Command="{Binding RegisterCommand}" >Register</Button>
		</StackPanel>
		
		<StackPanel IsVisible="{Binding UserIsLoggedIn}">
			<TextBlock Text="{Binding HelloText}"/>
			<Button Command="{Binding LogoutCommand}">Logout</Button>
			<Button Command="{Binding CreateCommand}">Create</Button>
			<Button Command="{Binding RefreshCommand}">Refresh</Button>
			<ListBox ItemsSource="{Binding ScoreDocuments}" x:Name="items">
				<ListBox.ItemTemplate>
					<DataTemplate x:DataType="m:ScoreDocumentMetaDataModel">
						<Grid ColumnDefinitions="* 40 40">
							<TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
							<Button Content="V" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding #items.((vma:UserAccountViewModel)DataContext).Restore}}" CommandParameter="{Binding}" Grid.Column="1"/>
							<Button Content="X" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding #items.((vma:UserAccountViewModel)DataContext).Delete}}" CommandParameter="{Binding}" Grid.Column="2"/>
						</Grid>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</StackPanel>
	</StackPanel>

</UserControl>
