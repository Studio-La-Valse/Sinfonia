<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit">

    <Style TargetType="{x:Type xctk:ColorPicker}" BasedOn="{StaticResource {x:Type xctk:ColorPicker}}">
        <Setter Property="Background" Value="{DynamicResource ABrush.Tone2.Background.Static}"/>
        <Setter Property="Foreground" Value="{DynamicResource Button.Static.Foreground}"/>
        <Setter Property="TabBackground" Value="{DynamicResource ABrush.Tone2.Background.Static}"/>
        <Setter Property="TabForeground" Value="{DynamicResource Button.Static.Foreground}"/>
        <Setter Property="HeaderBackground" Value="{DynamicResource ABrush.Tone2.Background.Static}"/>
        <Setter Property="HeaderForeground" Value="{DynamicResource Button.Static.Foreground}"/>
        <Setter Property="DropDownBackground" Value="{DynamicResource ABrush.Tone2.Background.Static}"/>
        <Setter Property="ShowDropDownButton" Value="False"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Button.Static.Border}"/>
        <Setter Property="DropDownBorderBrush" Value="{DynamicResource Button.Static.Border}"/>
        <Setter Property="ColorMode" Value="ColorCanvas"/>
        <Setter Property="ShowTabHeaders" Value="False"/>
    </Style>
    
</ResourceDictionary>